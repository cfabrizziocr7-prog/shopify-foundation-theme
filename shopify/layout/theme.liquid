<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="overflow-y-scroll">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <title>{{ page_title | escape }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% if canonical_url != blank %}
      <link rel="canonical" href="{{ canonical_url }}">
    {% endif %}

    {{ 'bundle.css' | asset_url | stylesheet_tag: preload: true }}

    <!-- header hook for Shopify plugins -->
    {{ content_for_header }}
  </head>

  <body class="sl-native">
    {% render 'sloane-styles' %}
    {% section 'sloane-header' %}
    {% if request.page_type == 'index' or request.page_type == 'product' or request.page_type == 'cart' %}
      <main id="main">{{ content_for_layout }}</main>
    {% elsif request.page_type == 'captcha' %}
      <main id="main">{{ content_for_layout }}</main>
    {% else %}
      <div id="app"><main id="main" class="container max-w-screen-xl py-12">{{ content_for_layout }}</main></div>
      <script src="{{ 'bundle.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    {% section 'sloane-footer' %}
  </body>
</html>
