{% render 'sloane-styles' %}
<footer class="sl-footer sl-wrap">
  <div><p class="sl-kicker">{{ section.settings.wordmark | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p class="sl-muted">{{ section.settings.text | escape }}</p></div>
  <nav aria-label="{{ 'sloane.nav.footer' | t }}">
    <a href="{{ routes.all_products_collection_url }}">{{ 'sloane.nav.shop' | t }}</a>
    <a href="{{ routes.root_url }}pages/contact">{{ 'sloane.nav.contact' | t }}</a>
    {% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}
  </nav>
  <p class="sl-footer__bottom">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }} <span>{{ 'sloane.nav.secure' | t }}</span></p>
</footer>
{% stylesheet %}
  .sl-footer{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding-block:64px 32px;border-top:1px solid var(--sl-line)}.sl-footer h2{font-size:36px;max-width:390px;margin-bottom:16px}.sl-footer nav{display:flex;flex-direction:column;align-items:flex-start;justify-self:end;font-size:12px;gap:14px}.sl-footer__bottom{grid-column:1/-1;display:flex;justify-content:space-between;font-size:10px;color:var(--sl-muted);border-top:1px solid var(--sl-line);padding-top:24px}.sl-footer p{max-width:440px}.sl-footer__bottom{max-width:none!important}@media(max-width:749px){.sl-footer{grid-template-columns:1fr;padding-bottom:110px}.sl-footer nav{justify-self:start}.sl-footer__bottom{gap:20px}}
{% endstylesheet %}
{% schema %}
{"name":"Sloane footer","settings":[{"type":"text","id":"wordmark","label":"Wordmark","default":"SLOANE EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Less effort. More outfit."},{"type":"text","id":"text","label":"Text","default":"Considered layers for wherever the day takes you."}]}
{% endschema %}
