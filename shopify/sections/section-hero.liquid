{% assign image = section.settings.image %}

<section class="vupi-editorial-hero">
  <a class="vupi-editorial-hero__media" href="{{ section.settings.button-url | default: routes.all_products_collection_url }}">
    {% if image %}
      <img
        sizes="100vw"
        srcset="{{ image | img_url: '750x' }} 750w, {{ image | img_url: '1200x' }} 1200w, {{ image | img_url: '1600x' }} 1600w, {{ image | img_url: '2000x' }} 2000w"
        src="{{ image | img_url: '2000x' }}"
        alt="{{ image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
        class="vupi-editorial-hero__image"
      >
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'vupi-editorial-hero__image vupi-editorial-hero__placeholder' }}
    {% endif %}

    <div class="vupi-editorial-hero__copy">
      {% if section.settings.headline != blank %}
        <h1>{{ section.settings.headline }}</h1>
      {% endif %}
      {% if section.settings.button-text != blank %}
        <span>{{ section.settings.button-text }} <span aria-hidden="true">→</span></span>
      {% endif %}
    </div>
  </a>
</section>

<style>
  .vupi-editorial-hero { width:100%; margin:0; background:#f4f1eb; }
  .vupi-editorial-hero__media { position:relative; display:block; width:100%; height:calc(100svh - 72px); min-height:620px; overflow:hidden; color:#111; text-decoration:none; }
  .vupi-editorial-hero__image { display:block; width:100%; height:100%; object-fit:cover; object-position:center; }
  .vupi-editorial-hero__placeholder { background:#efede8; }
  .vupi-editorial-hero__copy { position:absolute; left:7vw; top:50%; transform:translateY(-50%); max-width:280px; text-transform:uppercase; }
  .vupi-editorial-hero__copy h1 { margin:0 0 36px; max-width:240px; font:400 12px/1.8 Arial,sans-serif; letter-spacing:.38em; }
  .vupi-editorial-hero__copy span { display:inline-block; padding-bottom:5px; border-bottom:1px solid currentColor; font:400 11px/1.2 Arial,sans-serif; letter-spacing:.2em; }
  @media (max-width:749px) {
    .vupi-editorial-hero__media { height:82svh; min-height:560px; }
    .vupi-editorial-hero__copy { left:22px; top:auto; bottom:34px; transform:none; color:#fff; text-shadow:0 1px 8px rgba(0,0,0,.25); }
    .vupi-editorial-hero__copy h1 { margin-bottom:20px; font-size:10px; }
  }
</style>

{% schema %}
{
  "name": "VUPI editorial hero",
  "class": "shopify-section-vue",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Model image" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Essentials for a higher standard" },
    { "type": "url", "id": "button-url", "label": "Shop link" },
    { "type": "text", "id": "button-text", "label": "Link text", "default": "Shop now" }
  ],
  "presets": [{ "name": "VUPI editorial hero", "category": "Image" }]
}
{% endschema %}