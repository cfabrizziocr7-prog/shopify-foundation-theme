{% render 'sloane-styles' %}
{% assign jacket = section.settings.product %}
{% if jacket != blank %}
  {% assign hero = section.settings.hero_image | default: jacket.featured_image %}
  <section class="sl-home">
    <div class="sl-hero">
      <div class="sl-hero__photo">{{ hero | image_url: width: 1800 | image_tag: widths: '400, 600, 900, 1200, 1800', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: jacket.title }}<span class="sl-hero__caption">{{ 'sloane.home.caption' | t }}</span></div>
      <div class="sl-hero__copy"><p class="sl-kicker">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p class="sl-hero__intro">{{ section.settings.intro | escape }}</p><a class="sl-button" href="{{ jacket.url }}">{{ 'sloane.home.shop' | t }} <span aria-hidden="true">↗</span></a><p class="sl-hero__price">{{ jacket.price | money }} <span> / {{ 'sloane.home.color' | t }}</span></p></div>
    </div>
    <div class="sl-benefits sl-wrap"><p>{{ 'sloane.home.texture' | t }}</p><span aria-hidden="true">/</span><p>{{ 'sloane.home.shape' | t }}</p><span aria-hidden="true">/</span><p>{{ 'sloane.home.collar' | t }}</p></div>
    <div class="sl-story sl-wrap">
      <div class="sl-story__copy"><p class="sl-kicker">{{ 'sloane.home.details_kicker' | t }}</p><h2>{{ section.settings.detail_heading | escape }}</h2><p>{{ section.settings.detail_text | escape }}</p><a class="sl-link" href="{{ jacket.url }}">{{ 'sloane.home.explore' | t }} ↗</a></div>
      {% if section.settings.detail_image != blank %}<div class="sl-story__image">{{ section.settings.detail_image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy', alt: section.settings.detail_alt }}</div>{% endif %}
    </div>
    <div class="sl-style sl-wrap"><p class="sl-kicker">{{ 'sloane.home.style_kicker' | t }}</p><h2>{{ 'sloane.home.style_heading' | t }}</h2><div class="sl-style__grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="sl-kicker">0{{ forloop.index }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</div><a class="sl-button sl-button--light" href="{{ jacket.url }}">{{ 'sloane.home.find_fit' | t }} ↗</a></div>
  </section>
{% endif %}
{% stylesheet %}
  .sl-hero{display:grid;grid-template-columns:55% 45%;min-height:650px}.sl-hero__photo{position:relative;background:#eeece6;overflow:hidden}.sl-hero__photo img{width:100%;height:100%;object-fit:contain;max-height:790px;mix-blend-mode:multiply;padding:6%}.sl-hero__caption{position:absolute;left:32px;bottom:22px;font-size:9px;text-transform:uppercase;letter-spacing:.14em}.sl-hero__copy{align-self:center;padding:60px clamp(28px,5vw,84px)}.sl-hero__copy h1{max-width:500px;margin-bottom:28px}.sl-hero__intro{max-width:340px;line-height:1.8;font-size:15px;color:var(--sl-muted);margin-bottom:32px}.sl-hero__price{font-size:12px;margin-top:18px}.sl-hero__price span{color:var(--sl-muted)}.sl-benefits{display:flex;justify-content:space-around;align-items:center;gap:20px;padding-block:28px;border-bottom:1px solid var(--sl-line);font-size:11px;letter-spacing:.03em}.sl-benefits p{margin:0}.sl-benefits span{color:#aaa}.sl-story{display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:center;padding-block:90px}.sl-story__copy{max-width:440px}.sl-story__copy h2{margin-bottom:25px}.sl-story__copy>p:not(.sl-kicker){color:var(--sl-muted);line-height:1.9;margin-bottom:28px}.sl-story__image img{width:100%;height:560px;object-fit:cover}.sl-style{text-align:center;padding-block:30px 90px}.sl-style__grid{display:grid;grid-template-columns:repeat(3,1fr);text-align:left;gap:40px;margin:45px 0}.sl-style article{border-top:1px solid var(--sl-line);padding-top:25px}.sl-style article h3{font-family:Georgia,serif;font-size:25px;font-weight:400;margin:14px 0}.sl-style article p{font-size:14px;color:var(--sl-muted);max-width:320px}@media(max-width:749px){.sl-hero{grid-template-columns:1fr;min-height:0}.sl-hero__photo{height:340px}.sl-hero__photo img{padding:18px 30px 30px}.sl-hero__caption{left:20px;bottom:12px;font-size:8px}.sl-hero__copy{padding:30px 24px 32px}.sl-hero__copy .sl-kicker{margin-bottom:12px}.sl-hero__copy h1{max-width:290px;font-size:43px;margin-bottom:16px}.sl-hero__intro{font-size:14px;margin-bottom:22px}.sl-hero__copy .sl-button{width:100%}.sl-benefits{gap:8px;font-size:9px;padding-block:22px}.sl-story{grid-template-columns:1fr;gap:28px;padding-block:50px}.sl-story__image{grid-row:1}.sl-story__image img{height:340px}.sl-style{padding-block:15px 50px}.sl-style__grid{grid-template-columns:1fr;gap:24px;margin:30px 0}.sl-style article p{max-width:none}}
{% endstylesheet %}
{% schema %}
{"name":"Sloane home","settings":[{"type":"product","id":"product","label":"Product"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The fall / winter edit"},{"type":"text","id":"heading","label":"Heading","default":"Your new fall uniform."},{"type":"textarea","id":"intro","label":"Introduction","default":"Meet the Sloane Cropped Jacket. Rich texture, a statement collar, and an easy shape that brings the whole outfit together."},{"type":"image_picker","id":"detail_image","label":"Detail image"},{"type":"text","id":"detail_alt","label":"Image description","default":"Sloane jacket textured collar and silver zipper"},{"type":"text","id":"detail_heading","label":"Detail heading","default":"Quiet details. Lasting impression."},{"type":"textarea","id":"detail_text","label":"Detail copy","default":"A textured wool-look finish. A generous collar. A clean silver zip. Sloane adds dimension to simple layers, with a cropped silhouette that sits naturally above high-waisted denim and tailored trousers."}],"blocks":[{"type":"outfit","name":"Styling idea","limit":3,"settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"}]}],"presets":[{"name":"Sloane home"}]}
{% endschema %}
