{% render 'sloane-styles' %}
<section class="sl-cart sl-wrap"><p class="sl-kicker">{{ 'sloane.nav.bag' | t }}</p><h1>{{ 'sloane.cart.title' | t }}</h1>
{% if cart.item_count > 0 %}
  <form action="{{ routes.cart_url }}" method="post" id="SloaneCart">
    {% for item in cart.items %}<div class="sl-cart__item"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a><div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p class="sl-muted">{{ item.variant.title | escape }}</p>{% for property in item.properties %}{% assign key_start = property.first | slice: 0 %}{% unless property.last == blank or key_start == '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}<a class="sl-link" href="{{ item.url_to_remove }}">{{ 'sloane.cart.remove' | t }}</a></div><div><label class="sl-sr-only" for="CartQuantity-{{ forloop.index }}">{{ 'sloane.product.quantity' | t }}: {{ item.title | escape }}</label><input id="CartQuantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric"><p>{{ item.final_line_price | money }}</p>{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} −{{ discount.amount | money }}</p>{% endfor %}</div></div>{% endfor %}
    <div class="sl-cart__summary">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<p>{{ 'sloane.cart.subtotal' | t }} <strong>{{ cart.total_price | money_with_currency }}</strong></p><p class="sl-muted">{{ 'sloane.cart.checkout_note' | t }}</p><div><button class="sl-button sl-button--light" type="submit" name="update">{{ 'sloane.cart.update' | t }}</button><button class="sl-button" type="submit" name="checkout">{{ 'sloane.cart.checkout' | t }} ↗</button></div></div>
  </form>
{% else %}<p>{{ 'sloane.cart.empty' | t }}</p><a class="sl-button" href="{{ routes.root_url }}">{{ 'sloane.nav.shop' | t }} ↗</a>{% endif %}</section>
{% stylesheet %}
  .sl-cart{padding-block:55px 85px;min-height:60vh}.sl-cart__item{display:grid;grid-template-columns:100px 1fr 110px;gap:25px;padding:25px 0;border-bottom:1px solid var(--sl-line);font-size:13px}.sl-cart__item img{width:100px;height:130px;object-fit:contain;background:white}.sl-cart__item input{width:65px;padding:10px;border:1px solid var(--sl-line);background:transparent}.sl-cart__item>div:last-child{text-align:right}.sl-cart__summary{max-width:450px;margin:35px 0 0 auto;font-size:13px}.sl-cart__summary strong{float:right}.sl-cart__summary>div{display:flex;gap:12px;margin-top:25px}.sl-cart__summary .sl-button{flex:1}@media(max-width:749px){.sl-cart__item{grid-template-columns:70px 1fr 65px;gap:13px;font-size:12px}.sl-cart__item img{width:70px;height:100px}.sl-cart__summary>div{flex-direction:column}}
{% endstylesheet %}
{% schema %}{"name":"Sloane cart","settings":[]}{% endschema %}
