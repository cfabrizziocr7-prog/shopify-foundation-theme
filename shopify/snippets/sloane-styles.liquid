{% doc %}Shared styles for the Sloane storefront.{% enddoc %}
{% stylesheet %}
  :root{--sl-ink:#252722;--sl-paper:#f5f2eb;--sl-line:#d9d6ce;--sl-muted:#64675f;--sl-accent:#555e49}
  html{scroll-behavior:smooth;scroll-padding-top:90px}
  body{margin:0;background:var(--sl-paper);color:var(--sl-ink);font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6}
  .sl-native *{box-sizing:border-box}
  .sl-native h1,.sl-native h2,.sl-native h3,.sl-native p{margin-top:0}
  .sl-native h1,.sl-native h2{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.045em;line-height:1.04}
  .sl-native h1{font-size:clamp(40px,5vw,76px)}
  .sl-native h2{font-size:clamp(34px,4vw,54px)}
  .sl-native img{display:block;max-width:100%;height:auto}
  .sl-native a{color:inherit;text-underline-offset:4px}
  .sl-native button,.sl-native input,.sl-native select{font:inherit}
  .sl-native button{cursor:pointer}
  .sl-native [hidden]{display:none!important}
  .sl-native :focus-visible{outline:2px solid var(--sl-accent);outline-offset:5px}
  .sl-skip{position:fixed;left:16px;top:-100px;z-index:100;background:white;padding:12px}
  .sl-skip:focus{top:12px}
  .sl-announcement{text-align:center;padding:8px 16px;background:var(--sl-ink);color:var(--sl-paper);font-size:10px;letter-spacing:.13em;text-transform:uppercase}
  .sl-header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:23px 5vw;border-bottom:1px solid var(--sl-line);background:var(--sl-paper)}
  .sl-wordmark{font-family:Georgia,serif;font-size:25px;letter-spacing:.15em;text-decoration:none;white-space:nowrap}
  .sl-nav{display:flex;align-items:center;gap:30px;font-size:12px}
  .sl-nav a{text-decoration:none;min-height:44px;display:inline-flex;align-items:center;gap:6px}
  .sl-bag-count{border:1px solid var(--sl-line);border-radius:50%;min-width:23px;text-align:center;font-size:10px}
  .sl-wrap{width:min(1320px,90%);margin-inline:auto}
  .sl-kicker{font-size:10px;letter-spacing:.19em;text-transform:uppercase;color:var(--sl-muted);margin-bottom:20px}
  .sl-button{display:inline-flex;align-items:center;justify-content:center;gap:25px;padding:17px 25px;min-height:54px;background:var(--sl-ink);color:white!important;border:1px solid var(--sl-ink);text-decoration:none;font-size:12px;letter-spacing:.04em;border-radius:0}
  .sl-button:hover{background:#43483b}
  .sl-button:disabled{opacity:.5;cursor:not-allowed}
  .sl-button--light{background:transparent;color:var(--sl-ink)!important}
  .sl-button--light:hover{background:#e9e6de}
  .sl-link{font-size:12px;text-decoration:underline}
  .sl-muted{color:var(--sl-muted)}
  .sl-richtext{line-height:1.8}
  .sl-richtext ul{padding-left:20px;list-style:disc}
  .sl-richtext p{margin-bottom:16px}
  .sl-native details{border-top:1px solid var(--sl-line);padding:20px 0}
  .sl-native summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:18px;font-size:13px;min-height:30px}
  .sl-native summary::-webkit-details-marker{display:none}
  .sl-native summary::after{content:'+';font-size:20px;font-weight:400}
  .sl-native details[open] summary::after{content:'−'}
  .sl-native details .sl-answer{padding:18px 0 3px;color:var(--sl-muted);font-size:14px}
  .sl-rule{border:0;border-top:1px solid var(--sl-line);margin:24px 0}
  @media(max-width:749px){.sl-header{padding:10px 20px}.sl-wordmark{font-size:19px}.sl-nav{gap:16px}.sl-desktop{display:none!important}.sl-wrap{width:calc(100% - 40px)}.sl-native h1{font-size:42px}.sl-button{min-height:52px}.sl-announcement{font-size:9px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
.sl-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
{% endstylesheet %}